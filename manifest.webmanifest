{
  "name": "Eommu",
  "short_name": "Eommu",
  "description": "Tasks and daily schedules that work offline and stay on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#d4d8d9",
  "theme_color": "#d7dadb",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "short_name": "Today", "url": "./?view=today" },
    { "name": "Copy preset to today", "short_name": "Copy preset", "url": "./?action=copy" },
    { "name": "Capture a task", "short_name": "Capture", "url": "./?action=capture" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
